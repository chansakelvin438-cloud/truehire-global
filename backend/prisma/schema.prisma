generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  FLAGGED
  REJECTED
}

enum VerificationStatus {
  VERIFICATION_PENDING
  SUBMITTED_FOR_REVIEW
  VERIFIED
  FLAGGED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  REJECTED
}

enum ReportStatus {
  SUBMITTED
  INVESTIGATING
  RESOLVED
}

model User {
  id        String   @id @default(cuid())
  role      UserRole
  name      String
  email     String   @unique
  phone     String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobSeekerProfile  JobSeekerProfile?
  employerProfile   EmployerProfile?
  applications      Application[]
  notifications     Notification[]
  passwordResetOtps PasswordResetOtp[]
}

model JobSeekerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  phone             String?
  educationLevel    String?
  experienceLevel   String?
  preferredCategory String?
  preferredLocation String?
  skills            String?
  careerSummary     String?
  cvFileName        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  phone              String?
  website            String?
  address            String?
  verificationStatus VerificationStatus @default(VERIFICATION_PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                 Job[]
  verificationRequests EmployerVerification[]
  paymentSubmissions   PaymentSubmission[]
}

model Job {
  id                 String              @id @default(cuid())
  employerId         String?
  title              String
  company            String
  companyLogo        String?
  email              String
  phone              String?
  location           String
  type               String
  category           String
  salary             String?
  deadline           String
  experience         String?
  description        String
  requirements       String
  status             JobStatus           @default(PENDING_PAYMENT)
  paymentStatus      String              @default("PENDING_PAYMENT")
  pricingPlan        String              @default("LAUNCH_OFFER")
  amountDue          Int                 @default(50)
  currency           String              @default("ZMW")
  scamRiskLevel      String?
  scamRiskScore      Int?
  scamRiskReasons    String?
  adminNote          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  employer           EmployerProfile?    @relation(fields: [employerId], references: [id], onDelete: SetNull)
  applications       Application[]
  paymentSubmissions PaymentSubmission[]
}

model Application {
  id         String            @id @default(cuid())
  jobId      String
  userId     String
  fullName   String
  email      String
  phone      String?
  cvFileName String?
  cvFileUrl  String?
  coverNote  String?
  status     ApplicationStatus @default(SUBMITTED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployerVerification {
  id                           String             @id @default(cuid())
  employerId                   String
  companyName                  String
  email                        String
  phone                        String?
  companyRegistrationNumber    String
  tpin                         String
  businessType                 String
  address                      String
  contactPerson                String
  website                      String?
  businessRegistrationFileName String?
  businessRegistrationFileUrl  String?
  taxDocumentFileName          String?
  taxDocumentFileUrl           String?
  authorizationLetterFileName  String?
  authorizationLetterFileUrl   String?
  status                       VerificationStatus @default(SUBMITTED_FOR_REVIEW)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
}

model SafetyReport {
  id        String       @id @default(cuid())
  name      String
  email     String
  phone     String?
  jobTitle  String?
  message   String
  status    ReportStatus @default(SUBMITTED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  jobId     String?
  title     String
  message   String
  status    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  id             String   @id @default(cuid())
  userId         String
  deliveryTarget String
  channel        String
  codeHash       String
  expiresAt      DateTime
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentSubmission {
  id                   String   @id @default(cuid())
  jobId                String
  employerId           String
  amount               Int      @default(50)
  currency             String   @default("ZMW")
  paymentMethod        String
  transactionReference String
  payerPhone           String?
  note                 String?
  status               String   @default("SUBMITTED")
  adminNote            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actorId     String?
  actorRole   String?
  actorName   String?
  actorEmail  String?
  targetType  String
  targetId    String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}
